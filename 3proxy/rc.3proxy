#!/bin/bash

PID="$(awk '/pidfile/ {print $2}' @SYSCONFDIR@/3proxy/3proxy.cfg)"

case "$1" in
   start)
       echo Starting 3Proxy

       mkdir -p "$(dirname "$PID")"
       @PREFIX@/bin/3proxy @SYSCONFDIR@/3proxy/3proxy.cfg &

       RETVAL=$?
       echo
       [ $RETVAL ]
       ;;

   stop)
       echo Stopping 3Proxy
       if [ -f "$PID" ]; then
           kill "$(cat $PID)"
       else
           killall 3proxy
       fi

       RETVAL=$?
       echo
       [ $RETVAL ]
       ;;

   restart|reload)
       echo Reloading 3Proxy
       if [ -f "$PID" ]; then
           kill -s USR1 "$(cat $PID)"
       else
           killall -s USR1 3proxy
       fi
       ;;

   *)
       echo "Usage: $0 {start|stop|restart}"
       exit 1
esac
exit 0
