#!/bin/sh

case "$1" in
   start)
       echo Starting 3Proxy

       /bin/mkdir -p @LOCALSTATEDIR@/run/3proxy
       @PREFIX@/bin/3proxy @SYSCONFDIR@/3proxy/3proxy.cfg &

       RETVAL=$?
       echo
       [ $RETVAL ]
       ;;

   stop)
       echo Stopping 3Proxy
       if [ -f @LOCALSTATEDIR@/run/3proxy/3proxy.pid ]; then
           /bin/kill $(cat @LOCALSTATEDIR@/run/3proxy/3proxy.pid)
       else
               /usr/bin/killall 3proxy
       fi

       RETVAL=$?
       echo
       [ $RETVAL ]
       ;;

   restart|reload)
       echo Reloading 3Proxy
       if [ -f @LOCALSTATEDIR@/run/3proxy/3proxy.pid ]; then
           /bin/kill -s USR1 $(cat @LOCALSTATEDIR@/run/3proxy/3proxy.pid)
       else
               /usr/bin/killall -s USR1 3proxy
       fi
       ;;


   *)
       echo Usage: $0 "{start|stop|restart}"
       exit 1
esac
exit 0
