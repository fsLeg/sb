#!/bin/bash

SERVNAME="amnezia"
SERVBIN="@PREFIX@/lib@LIBDIRSUFFIX@/amnezia-client/AmneziaVPN-service"

function start() {
  /usr/bin/daemon --name=$SERVNAME \
                  --respawn \
                  --delay=10 \
                  -- $SERVBIN
}

function stop() {
  /usr/bin/daemon --name=$SERVNAME --stop
}

function restart() {
  /usr/bin/daemon --name=$SERVNAME --restart
}

function status() {
  /usr/bin/daemon --name=$SERVNAME --verbose --running
}

function usage() {
  echo "Usage: $0 [start|stop|restart|status]"
}

case "$1" in
         "") start   ;;
    "start") start   ;;
     "stop") stop    ;;
  "restart") restart ;;
   "status") status  ;;
          *) usage   ;;
esac
