# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="pyscard"
VERSION="2.3.2"
BUILD="${BUILD:-1}"
DESCRIPTION="Smartcard module for Python"
HOMEPAGE="https://pyscard.sourceforge.io/"
DOWNLOAD="https://github.com/LudovicRousseau/pyscard/archive/${VERSION}/${PRGNAM}-${VERSION}.tar.gz"
SHA256SUM="822ff0cd34b188c859c72d7426dfe8393d517e0e03ac0245bd57d0e2b1e94f30"
REQUIRES=(pcsc-lite)
OPTIONAL=(Sphinx)

unpack () {
  $UNTAR $CWD/$PRGNAM-$VERSION.tar.gz
}

build () {
  python3 setup.py install --root=$PKG

  if [ "${DOCS:-no}" != "no" ]; then
    sphinx-build src/smartcard/doc $PKGDOC/html
    rm -rf $PKGDOC/html/{.buildinfo,.doctrees,objects.inv}
  fi
  cp -a -t $PKGDOC \
    ACKS ChangeLog LICENSE TODO README.md src/smartcard/Examples
}
