# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="ollama"
VERSION="0.30.10"
BUILD="${BUILD:-1}"
DESCRIPTION="Download and run large language models locally"
HOMEPAGE="https://github.com/ollama/ollama"
DOWNLOAD="https://github.com/${PRGNAM}/${PRGNAM}/archive/v${VERSION}/${PRGNAM}-${VERSION}.tar.gz"
SHA256SUM="9a172295f668cb91b6f9065f0767e805fe59da679145191798933b9d36b45b93"
BUILD_REQUIRES="cmake-opt google-go-lang"
OPTIONAL="cudatoolkit_13 rocmtoolkit_7"

unpack () {
  check_gid ollama 393
  check_uid ollama 393
  tar xfv $CWD/$PRGNAM-$VERSION.tar.gz

  if [[ ! -v CUDA ]] && command -v nvcc &> /dev/null; then
    CUDA="ON"
  fi

  if [[ ! -v ROCM ]] && command -v hipconfig &> /dev/null; then
    ROCM="ON"
  fi

  if [[ ! -v VULKAN ]] && pkg-config --atleast-version=1.4 vulkan; then
    VULKAN="ON"
  fi

  [[ "$CUDA"   == "ON" ]] && BACKENDS+="cuda_v13;"
  [[ "$ROCM"   == "ON" ]] && BACKENDS+="rocm_v7_2;"
  [[ "$VULKAN" == "ON" ]] && BACKENDS+="vulkan;"

  [[ -v LLAMACPP ]] && echo "$LLAMACPP" > $PRGNAM-$VERSION/LLAMA_CPP_VERSION

  # don't copy system libraries
  # https://gitlab.archlinux.org/archlinux/packaging/packages/ollama/-/blob/main/PKGBUILD?ref_type=heads
  sed -i 's/PRE_INCLUDE_REGEXES.*/PRE_INCLUDE_REGEXES = ""/g' $PRGNAM-$VERSION/llama/server/CMakeLists.txt

  # fix hardcoded path
  # https://data.gpo.zugaina.org/guru/sci-ml/ollama/ollama-0.21.2.ebuild
  # grep -Rl -e 'lib/ollama' -e '"..", "lib"'  --include '*.go'
  sed -i "s|\"..\", \"lib\"|\"..\", \"lib$LIBDIRSUFFIX\"|g
          s|\"lib/ollama\"|\"lib$LIBDIRSUFFIX/ollama\"|g" \
      $PRGNAM-$VERSION/llm/llama_binary.go \
      $PRGNAM-$VERSION/ml/path.go

  # add "PARAMETER think" for Modelfile, PR14108
  patch -p1 -d $PRGNAM-$VERSION -i $CWD/14108.patch
}

build () {
  cmake -B build \
        -DOLLAMA_LIB_DIR="lib$LIBDIRSUFFIX/$PRGNAM" \
        $([[ -n "$BACKENDS" ]] && echo "-DOLLAMA_LLAMA_BACKENDS=${BACKENDS%;}")
  cmake --build build

  DESTDIR=$PKG \
    cmake --install build \
          --prefix "$_PREFIX"
  for LIB in $PKG/$_PREFIX/lib$LIBDIRSUFFIX/$PRGNAM/libggml-cpu-*.so; do
    if patchelf --print-rpath $LIB | grep -q $TMP; then
      patchelf --set-rpath '$ORIGIN' $LIB
    fi
  done
  install -Dm755 -t $PKG/$_PREFIX/bin $PRGNAM
  install -Dm755 $CWD/rc.$PRGNAM $PKG/$SYSCONFDIR/rc.d/rc.$PRGNAM.new
  install -Dm644 $CWD/$PRGNAM.default $PKG/$SYSCONFDIR/default/$PRGNAM.new
  install -Dm644 $CWD/$PRGNAM.logrotate $PKG/$SYSCONFDIR/logrotate.d/$PRGNAM.new
  sed -i "s|@PREFIX@|$_PREFIX|g
          s|@SYSCONFDIR@|$SYSCONFDIR|g
          s|@LOCALSTATEDIR@|$LOCALSTATEDIR|g" \
      $PKG/$SYSCONFDIR/rc.d/rc.$PRGNAM.new \
      $PKG/$SYSCONFDIR/default/$PRGNAM.new \
      $PKG/$SYSCONFDIR/logrotate.d/$PRGNAM.new

  install -d $PKG/$_PREFIX/doc/$PRGNAM-$VERSION
  cp -aR -t $PKG/$_PREFIX/doc/$PRGNAM-$VERSION \
    CONTRIBUTING.md LICENSE README.md SECURITY.md docs/
  install -d $PKG/install
  sed "s|@SYSCONFDIR@|${SYSCONFDIR#/}|g" \
       $CWD/doinst.sh > $PKG/install/doinst.sh
}
