# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="ocserv"
VERSION="1.5.0"
BUILD="${BUILD:-1}"
DESCRIPTION="OpenConnect SSL VPN server"
HOMEPAGE="https://ocserv.openconnect-vpn.net"
DOWNLOAD="https://www.infradead.org/ocserv/download/${PRGNAM}-${VERSION}.tar.xz"
SHA256SUM="42ced08958b9576ab134fcb7bdc7f8df5e13214fd147855f99021fedcf0eedbe"
REQUIRES="libev protobuf-c"
BUILD_REQUIRES="ipcalc-ng"
OPTIONAL="GeoIP libmaxmind llhttp oath-toolkit rubygem-ronn"

unpack () {
  check_gid ocserv 382
  check_uid ocserv 382
  tar xvf $CWD/$PRGNAM-$VERSION.tar.xz

  # this lets meson detect nft binary and use nftables instead of iptables
  export PATH+=":/usr/sbin"
}

build () {
  meson setup \
    --prefix=$_PREFIX \
    --libdir=$_PREFIX/lib${LIBDIRSUFFIX} \
    --sysconfdir=$SYSCONFDIR \
    --localstatedir=$LOCALSTATEDIR \
    --mandir=$_PREFIX/man \
    --buildtype=release \
    -Dlibwrap=disabled \
    build
  meson compile -C build

  meson install --destdir=$PKG -C build
  install -Dm644 -t $PKG/$_PREFIX/doc/$PRGNAM-$VERSION \
    AUTHORS CONTRIBUTING* COPYING NEWS README* doc/README* doc/sample.* doc/scripts/*
  install -Dm755 $CWD/rc.ocserv $PKG/$SYSCONFDIR/rc.d/rc.ocserv.new
  install -Dm644 $CWD/ocserv.conf $PKG/$SYSCONFDIR/ocserv/ocserv.conf.new
  sed -i "s|@PREFIX@|$_PREFIX|g
          s|@SYSCONFDIR@|$SYSCONFDIR|g
          s|@LOCALSTATEDIR@|$LOCALSTATEDIR|g" \
      $PKG/$SYSCONFDIR/rc.d/rc.ocserv.new \
      $PKG/$SYSCONFDIR/ocserv/ocserv.conf.new
  install -d $PKG/install
  sed "s|@SYSCONFDIR@|${SYSCONFDIR#/}|g" \
       $CWD/doinst.sh > $PKG/install/doinst.sh
}
