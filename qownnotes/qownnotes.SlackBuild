# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="qownnotes"
VERSION="26.9.0"
BUILD="${BUILD:-1}"
DESCRIPTION="notepad with markdown support and Nextcloud integration"
HOMEPAGE="https://www.qownnotes.org/"
DOWNLOAD="https://github.com/pbek/QOwnNotes/releases/download/v${VERSION}/${PRGNAM}-${VERSION}.tar.xz"
SHA256SUM="1669336f29b00533ad78cc193fe5e197edcffdc14a636d3a4320e7eb017571fa"
OPTIONAL=(Botan libgit2 qt6)

unpack () {
  $UNTAR $CWD/$PRGNAM-$VERSION.tar.xz

  # Set the release string to disable the update check
  echo '#define RELEASE "SlackBuild"' > release.h

  # Autodetect options
  if [[ ! -v QT6 && "$SLACKVER" == "current" ]]; then
    QT6="yes"
  fi

  if [[ ! -v LIBGIT2 ]] && pkg-config --exists libgit2; then
    LIBGIT2="yes"
  fi

  if [[ ! -v BOTAN ]] && pkg-config --exists botan-3; then
    BOTAN="yes"
  fi

  # Set options
  if [[ "${QT6:-no}" != "no" ]]; then
    USE_QT6="-DQON_QT6_BUILD=ON"
    REQUIRES+=(qt6)
  fi

  if [[ "${LIBGIT2:-no}" != "no" ]]; then
    USE_LIBGIT2="-DBUILD_WITH_LIBGIT2=ON"
    REQUIRES+=(libgit2)
  fi

  if [[ "${BOTAN:-no}" != "no" ]]; then
    USE_SYSTEM_BOTAN="-DBUILD_WITH_SYSTEM_BOTAN=ON"
    REQUIRES+=(Botan)
  fi
}

build () {
  cmake \
    -DCMAKE_INSTALL_PREFIX=$_PREFIX \
    -DBUILD_WITH_ASPELL=ON \
    $USE_QT6 \
    $USE_LIBGIT2 \
    $USE_SYSTEM_BOTAN \
    -DCMAKE_BUILD_TYPE=Release \
    -B build
  cmake --build build

  DESTDIR=$PKG cmake --install build
  install -Dm644 -t $PKG/$_PREFIX/doc/$PRGNAM-$VERSION \
    CHANGELOG.md LICENSE README.md shortcuts.md
}
