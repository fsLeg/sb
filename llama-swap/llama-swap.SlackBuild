# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="llama-swap"
VERSION="268"
BUILD="${BUILD:-1}"
DESCRIPTION="Model swapping for local LLM servers"
HOMEPAGE="https://github.com/mostlygeek/llama-swap"
DOWNLOAD="https://github.com/mostlygeek/llama-swap/archive/v${VERSION}/${PRGNAM}-${VERSION}.tar.gz"
SHA256SUM="ddb232f548b6dc36a5ff4705df52f7b3f13f49669896957d54aae2dc6c1b04b4"
BUILD_REQUIRES=(google-go-lang "nodejs|nodejs22|nodejs24-bin")
SUGGESTS=(llama.cpp ollama stable-diffusion.cpp)

unpack () {
  $UNTAR $CWD/$PRGNAM-$VERSION.tar.gz

  # sidestep git requirement
  rm -rf $TMP/.bin
  mkdir -p $TMP/.bin
	cat <<EOF > $TMP/.bin/git
#!/bin/bash
case "\$1" in
  ls-files)
    find . -path "./ui/node_modules" -prune -o -type f \( -name "*.go" -o -path "./ui/*.ts" -o -path "./ui/*.svelte" \) ! -name "*_test.go" ! -name "*.test.ts" -print0
    ;;
  describe)
    echo $VERSION
    ;;
  rev-parse)
    curl -s "https://api.github.com/repos/mostlygeek/llama-swap/git/ref/tags/v$VERSION" | awk '/sha/ {print \$2}' | tr -d '",' | head -c7
    ;;
  status)
    :
    ;;
  *)
    /usr/bin/git "\$@"
    ;;
esac
EOF
  chmod +x $TMP/.bin/git
  export PATH=$TMP/.bin:$PATH
}

build () {
  make linux-$DEBARCH

  install -Dm755 build/$PRGNAM-linux-$DEBARCH $PKG/$_PREFIX/bin/$PRGNAM
  cp -a -t $PKGDOC \
    docs/{kb,config.example.yaml} CHANGELOG.md CONTRIBUTING.md LICENSE.md README.md
}
