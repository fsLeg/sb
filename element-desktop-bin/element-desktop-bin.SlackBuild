# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="element-desktop-bin"
VERSION="1.12.19"
BUILD="${BUILD:-1}"
DESCRIPTION="Secure and independent communication via Matrix"
HOMEPAGE="https://element.io/"
DOWNLOAD="https://packages.element.io/debian/pool/main/e/${PRGNAM%-bin}/${PRGNAM%-bin}_${VERSION}_${DEBARCH}.deb"
SHA256SUM="d42d0a9f8fdc211fb3c5536a7ec9c0ee9fa174a686f8c27ea5fd4f4fc40cf187"
REQUIRES="sqlcipher"
CONFLICTS="element-desktop"

unpack () {
  mkdir $PRGNAM-$VERSION
  ar xv --output $PRGNAM-$VERSION $CWD/${PRGNAM%-bin}_${VERSION}_${DEBARCH}.deb data.tar.xz
}

build () {
  tar xvf data.tar.xz -C $PKG
  install -Dm644 -t $PKG/$_PREFIX/doc/$PRGNAM-$VERSION \
    $PKG/usr/share/doc/${PRGNAM%-bin}/* $PKG/opt/Element/LICENSE*
  rm -rf $PKG/usr/share/doc
}
