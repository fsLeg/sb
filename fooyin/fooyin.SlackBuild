# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="fooyin"
VERSION="0.12.0"
BUILD="${BUILD:-1}"
DESCRIPTION="customisable music player"
HOMEPAGE="https://fooyin.org/"
DOWNLOAD="https://github.com/fooyin/fooyin/archive/v${VERSION}/${PRGNAM}-${VERSION}.tar.gz"
SHA256SUM="04e07f19578a4a5df954f3ba3222dc3edf63839914229c968d2e4dcd1b978b64"
REQUIRES="qt6"
OPTIONAL="KDSingleApplication libebur128 libgme libopenmpt soundtouch soxr"

unpack () {
  tar xvf $CWD/$PRGNAM-$VERSION.tar.gz
}

build () {
  cmake -G Ninja \
        -B build \
        -DFETCH_PROJECTM="ON"
  cmake --build build

  DESTDIR=$PKG \
  cmake --install build \
        --prefix $_PREFIX

  rm -rf $PKG/$_PREFIX/{include,lib$LIBDIRSUFFIX/cmake}
  rm -rf $PKG/$_PREFIX/lib$LIBDIRSUFFIX/*.a

  install -Dm644 -t $PKG/$_PREFIX/doc/$PRGNAM-$VERSION CHANGELOG.md
  mv $PKG/$_PREFIX/share/doc/fooyin/* $PKG/$_PREFIX/doc/$PRGNAM-$VERSION
  rm -rf $PKG/$_PREFIX/share/doc
}
