# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="fooyin"
VERSION="0.12.5"
BUILD="${BUILD:-1}"
DESCRIPTION="customisable music player"
HOMEPAGE="https://fooyin.org/"
DOWNLOAD="https://github.com/fooyin/fooyin/archive/v${VERSION}/${PRGNAM}-${VERSION}.tar.gz"
SHA256SUM="ed5c2804c31ae81e176bb0761c624787fd1929455a673c730be5c16e6d1eb1ea"
REQUIRES=(qt6)
OPTIONAL=(KDSingleApplication libebur128 libgme libopenmpt soundtouch soxr)

unpack () {
  $UNTAR $CWD/$PRGNAM-$VERSION.tar.gz

  if [[ -d /usr/lib$LIBDIRSUFFIX/cmake/KDSingleApplication-qt6 && "$SLACKVER" != "current" ]];
                                     then REQUIRES+=(KDSingleApplication); fi
  if pkg-config --exists libebur128; then REQUIRES+=(libebur128); fi
  if pkg-config --exists libgme;     then REQUIRES+=(libgme); fi
  if pkg-config --exists libopenmpt; then REQUIRES+=(libopenmpt); fi
  if pkg-config --exists soundtouch; then REQUIRES+=(soundtouch); fi
  if pkg-config --exists soxr;       then REQUIRES+=(soxr); fi
}

build () {
  cmake -G Ninja \
        -B build \
        -DFETCH_PROJECTM="ON"
  cmake --build build

  DESTDIR=$PKG \
  cmake --install build \
        --prefix $_PREFIX

  rm -rf $PKG/$_PREFIX/{include,lib$LIBDIRSUFFIX/cmake}
  rm -rf $PKG/$_PREFIX/lib$LIBDIRSUFFIX/*.a

  install -Dm644 -t $PKG/$_PREFIX/doc/$PRGNAM-$VERSION CHANGELOG.md
  mv $PKG/$_PREFIX/share/doc/fooyin/* $PKG/$_PREFIX/doc/$PRGNAM-$VERSION
  rm -rf $PKG/$_PREFIX/share/doc
}
