# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="yubico-authenticator-bin"
PRGNAME="${PRGNAM%-bin}"
VERSION="7.5.0"
BUILD="${BUILD:-1}"
DESCRIPTION="Yubico Authenticator for Desktop"
HOMEPAGE="https://www.yubico.com/products/yubico-authenticator/"
DOWNLOAD="https://developers.yubico.com/yubioath-flutter/Releases/${PRGNAME}-${VERSION}-linux-${PLATFORM}.tar.gz"
SHA256SUM="4fa2be54df0dd605ad19cc11db43cc08f5621513dba2e41c97cd1142c32289cb"
REQUIRES=(pcsc-lite ccid)

unpack () {
  $UNTAR $CWD/$PRGNAME-$VERSION-linux-$PLATFORM.tar.gz
  mv $PRGNAME-$VERSION-linux-$PLATFORM $PRGNAM-$VERSION
}

build () {
  install -d $PKG/opt/${PRGNAME}
  cp -a -t $PKG/opt/${PRGNAME} data/ helper/ lib/ linux_support/ authenticator
  install -Dm644 -t $PKG/$_PREFIX/share/applications linux_support/com.yubico.yubioath.desktop
  sed -i "s|@EXEC_PATH|/opt/${PRGNAME}|g" $PKG/$_PREFIX/share/applications/com.yubico.yubioath.desktop
  install -d $PKG/$_PREFIX/bin
  cat << EOF > $PKG/$_PREFIX/bin/authenticator
#!/bin/sh
/opt/${PRGNAME}/authenticator $@
EOF
  chmod 755 $PKG/$_PREFIX/bin/authenticator
  install -Dm644 -t $PKGDOC README.adoc
}
