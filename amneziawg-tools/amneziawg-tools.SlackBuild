# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="amneziawg-tools"
VERSION="3.1.20260812"
BUILD="${BUILD:-1}"
DESCRIPTION="Tools for configuring AmneziaWG"
HOMEPAGE="https://github.com/amnezia-vpn/amneziawg-tools"
DOWNLOAD="https://github.com/amnezia-vpn/amneziawg-tools/archive/v${VERSION}/${PRGNAM}-${VERSION}.tar.gz"
SHA256SUM="dbd8ce0748d835d18f30bb76720246b7bfc80bd09cd17c379b1c59f683a18493"
SUGGESTS=(amneziawg-go amneziawg-kernel)
PKGVER="${VERSION//-/.}"

unpack () {
  $UNTAR $CWD/$PRGNAM-$VERSION.tar.gz
}

build () {
  make -C src

  PREFIX=$_PREFIX \
  LIBDIR=$_PREFIX/lib${LIBDIRSUFFIX} \
  MANDIR=$_PREFIX/man \
  WITH_BASHCOMPLETION=yes \
  WITH_WGQUICK=yes \
  WITH_SYSTEMDUNITS=no \
  DESTDIR=$PKG \
  make -C src install

  install -d $PKG/$_PREFIX/doc/$PRGNAM-$PKGVER
  cp -aR -t $PKG/$_PREFIX/doc/$PRGNAM-$PKGVER \
    COPYING README.md contrib/
}
