# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="amneziawg-go"
VERSION="3.1.20260828"
BUILD="${BUILD:-1}"
DESCRIPTION="AmneziaWG VPN protocol"
HOMEPAGE="https://github.com/amnezia-vpn/amneziawg-go"
DOWNLOAD="https://github.com/amnezia-vpn/amneziawg-go/archive/v${VERSION}/${PRGNAM}-${VERSION}.tar.gz"
SHA256SUM="24c656cfb80ff6855702710eaf2e3729fa710bf6bfdbbbdfba01984ccd17de95"
BUILD_REQUIRES=(google-go-lang)
SUGGESTS=(amneziawg-tools)

unpack () {
  $UNTAR $CWD/$PRGNAM-$VERSION.tar.gz
}

build () {
  go build -v

  install -Dm755 -t $PKG/$_PREFIX/sbin amneziawg-go
  install -Dm644 -t $PKG/$_PREFIX/doc/$PRGNAM-$VERSION LICENSE README.md
}
