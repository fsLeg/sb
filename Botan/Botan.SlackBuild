# Maintainer: Vladislav 'fsLeg' Borisov <fsleg at t-rg dot ws>

PRGNAM="Botan"
VERSION="3.14.1"
BUILD="${BUILD:-1}"
DESCRIPTION="C++ crypto library"
HOMEPAGE="https://botan.randombit.net/"
DOWNLOAD="https://botan.randombit.net/releases/${PRGNAM%3}-${VERSION}.tar.xz"
SHA256SUM="5b85cba0f014d344eb8e9919aee0a3bdc31e16acb05816410025be9bee1e0930"

unpack () {
  $UNTAR $CWD/$PRGNAM-$VERSION.tar.xz
}

build () {
  python3 configure.py \
    --prefix=$_PREFIX \
    --docdir=doc \
    --libdir=lib$LIBDIRSUFFIX \
    --mandir=$_PREFIX/man \
    --disable-static \
    --with-rst2man \
    --without-sphinx \
    $([[ "${DOCS@L}" == "yes" ]] && echo --with-doxygen) \
    --with-bzip2 \
    --with-zlib \
    --with-lzma \
    --with-boost \
    --with-sqlite3 \
    --with-commoncrypto
  make

  make install DESTDIR=$PKG
  mv $PKG/$_PREFIX/doc/${PRGNAM@L}-$VERSION/* $PKGDOC/
  rmdir $PKG/$_PREFIX/doc/${PRGNAM@L}-$VERSION
  install -Dm644 -t $PKGDOC license.txt readme.rst
}
